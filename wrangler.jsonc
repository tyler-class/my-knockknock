{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-knockknock",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  // Needed for OAuth clients that identify themselves with a metadata URL.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Hourly: the anonymous daily check-in (at most once a day; off switch in Settings), and
  // notifications (interviews today, follow-ups, debriefs) in each device's own time zone.
  "triggers": { "crons": ["41 * * * *"] },
  "upload_source_maps": true,
  "assets": {
    // Static SPA. Unknown paths fall back to index.html; /api/* always reaches the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/oauth/*",
      "/.well-known/*",
      "/upload/*",
    ],
  },
  "d1_databases": [
    {
      // No database_id: the Deploy button and `wrangler deploy` provision it automatically.
      "binding": "DB", "database_id": "0237f102-082a-43d0-b80f-9919257195fe",
      "database_name": "my-knockknock",
      "migrations_dir": "migrations",
    },
  ],
  // A browser to read job postings that only fill in with JavaScript (read_posting). Nothing to
  // create: the binding is all it takes, and it works on the Workers Free plan.
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      // Resumes, cover letters, transcripts and offer letters. Private: served only through
      // /api/files/:id to signed-in users. Created on first deploy if it doesn't exist.
      "binding": "FILES",
      "bucket_name": "my-knockknock-files",
    },
  ],
  "kv_namespaces": [
    {
      // Sign-ins for AI assistants connected over MCP. Provisioned automatically on deploy.
      "binding": "OAUTH_KV", "id": "cc7fe7875e3244f9824346644eaf1394",
    },
  ],
}
